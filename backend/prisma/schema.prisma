generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEAM_MEMBER
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  role UserRole
  createdAt DateTime @default(now())

  events Event[]
}

model Event {
  id String @id @default(uuid())
  name String
  description String?
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
}